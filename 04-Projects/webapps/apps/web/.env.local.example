# The backend-origin variable used server-side only — by the /api/auth/google/callback and
# /api/auth/refresh routes, by the catch-all /api/proxy/[...path] route, and as every domain
# service package's (account-service, etc.) default configure*Service({ baseURL }) fallback
# (specs/005-auth-proxy-refactor/research.md §3). A Client Component reaches the backend by
# pointing a package's baseURL at "/api/proxy" instead
# (specs/005-auth-proxy-refactor/contracts/proxy-routes.md), never at this variable directly.
BACKEND_URL=http://localhost:3001

# Backend origin the browser navigates to directly for LoginCard's "Sign in with Google" button
# (components/organisms/LoginCard.tsx — a top-level window.location redirect, not a fetch/XHR
# call, so it carries no token and is a different concern from BACKEND_URL above; see
# specs/005-auth-proxy-refactor/research.md §3 for why this one still needs the NEXT_PUBLIC_
# prefix while the domain-service packages' default no longer does).
NEXT_PUBLIC_GAME_HUB_API_BASE_URL=http://localhost:3001

# See quickstart.md Prerequisites: the backend's own callbackUrl env var (not set here — it
# lives in the backend's deployment config) must be pointed at
# http://localhost:3000/api/auth/google/callback for this app's dev server, with a matching
# redirect URI registered in Google Cloud Console.
