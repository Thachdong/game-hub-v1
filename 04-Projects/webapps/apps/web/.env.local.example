# Backend origin used client-side by the domain service packages (account-service, etc.)
# via their configure*Service({ baseURL }) wiring. Must be reachable from the browser.
NEXT_PUBLIC_GAME_HUB_API_BASE_URL=http://localhost:3001

# Backend origin used server-side only, by the /api/auth/google/callback proxy Route Handler
# (research.md §1) to forward the OAuth callback. Usually the same value as above, but kept
# separate since this one is never exposed to the browser.
BACKEND_URL=http://localhost:3001

# NextAuth's session-encryption secret. Generate with: npx auth secret
AUTH_SECRET=

# See quickstart.md Prerequisites: the backend's own callbackUrl env var (not set here — it
# lives in the backend's deployment config) must be pointed at
# http://localhost:3000/api/auth/google/callback for this app's dev server, with a matching
# redirect URI registered in Google Cloud Console.
